# ── Head-on vortex-ring collision (GPU-resident 3D LFM) ────────────────────
# Two coaxial rings of opposite circulation collide along x and burst radially.
# Run: ./build/cfdsim inputs/vortex_collision.in
# Higher-res viscous example: ./build/cfdsim inputs/vortex_collision.in NX=192 NY=192 NZ=192 Re=300 dt=0.0007

scenario   = vortex_collision

backend    = auto       # auto: 有GPU就用GPU，没有自动保底CPU。也可写死 gpu / cpu

NX         = 96
NY         = 96
NZ         = 96
cycles     = 120
dt         = 0.001
Re         = 0            # 0 = inviscid; set e.g. 300 for a viscous run

circulation = 1.0
perturb_n   = 0           # azimuthal seed mode (0 = none; e.g. 8 to seed the burst)
perturb_amp = 0.0         # seed amplitude

frame_skip = 4
vtk_mode   = slim         # |omega| only — disk-friendly at higher resolution
out_dir    = output_vortex_collision
# gpu      = 0

# ── 后处理（pipeline.sh / render/render.py 读取）──────────────────────────
render_mode  = iso3d       # iso3d | slice | volume | none（可逗号组合，如 iso3d,slice）
render_level = 0.15        # 等值面 = 此值 × 全程 99.5 分位 |ω|
render_orbit = 120         # 转台旋转角度（iso3d）；0 = 固定视角
