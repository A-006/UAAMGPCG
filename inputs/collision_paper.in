# ── Paper-faithful head-on collision (LFM paper Fig. 3) ────────────────────
# Authors' recipe: grid 128x256x256 (collision axis = short 128 dir), INVISCID
# with the BFECC neighbour clamp as numerical viscosity, n=5 steps/cycle, CG
# fixed at 8 iterations. Domain 0.5x1x1 keeps dx=dy=dz uniform (= 1/256).
# Run: ./build/cfdsim inputs/collision_paper.in
#
# Convergence study: bump all three N together (rings auto-scale), e.g.
#   ./build/cfdsim inputs/collision_paper.in NX=64  NY=128 NZ=128 out_dir=output_conv64
#   ./build/cfdsim inputs/collision_paper.in NX=160 NY=320 NZ=320 out_dir=output_conv160

scenario   = collision_paper
dim        = 3            # 3D scenario (the launcher routes dim==3 to the 3D engine)

backend    = auto       # auto: 有GPU就用GPU，没有自动保底CPU。也可写死 gpu / cpu

NX         = 128
NY         = 256
NZ         = 256
cycles     = 260
dt         = 1e-4         # paper value for the SHARP variant-D rings (max|u|~32 →
                         # CFL~1.6 at dt=1e-4). dt=4e-4 blows up on the sharp IC.
Lx         = 0.5          # collision axis (short) — keeps dx=dy=dz uniform
Ly         = 1.0
Lz         = 1.0
U_inf      = 1.0
Re         = 0            # inviscid — stability from the BFECC clamp below
cyl_R      = 0.1
lfm_cycle_steps = 5       # paper: n = 5 steps per reinitialization cycle
solve_tol       = 0.0     # fixed-iteration CG (no tolerance early-out)

lfm_bfecc_clamp = 1       # paper's BfeccClamp (1 = on). Set 0 to see it blow up.
solve_iters     = 8       # paper: CG fixed at 8 iterations

# ── Initial condition: validated "variant D" head-on collision (paper Fig. 3).
# Two small & SHARP rings of opposite circulation so the merged ring stays inside
# the box during the azimuthal instability and bursts radially (碰撞爆炸) instead
# of expanding into the y-z wall. Parameter-searched against the author binary:
#   r=0.04, core=0.012, circ=±1.8, sep=0.10 (centers 0.20 & 0.30 on the 0.5-long
#   x axis), nseg=400 → ring radius 74–91 cells < 95 wall threshold, clean k≈8
#   starburst. A bigger/blunter IC (r=0.10, core=0.022, circ=1.0) gives a smooth
#   ring that only "sheds" filaments when it slams the wall — a boundary artifact,
#   not a collision burst. Don't restore it. Too strong (≥2.0) or too large → hits
#   the wall; too weak (≤1.3) → dissipation smears it. center/radius/core are
#   ABSOLUTE coordinates (x axis Lx=0.5, so sep 0.10 = centers 0.20 & 0.30).
ic              = vortex_ring
ic0.center      = 0.20,0.5,0.5
ic0.axis        = 1.0,0.0,0.0
ic0.radius      = 0.04
ic0.core        = 0.012
ic0.circulation = 1.8
ic0.n_segments  = 400

ic1             = vortex_ring
ic1.center      = 0.30,0.5,0.5
ic1.axis        = 1.0,0.0,0.0
ic1.radius      = 0.04
ic1.core        = 0.012
ic1.circulation = -1.8
ic1.n_segments  = 400

frame_skip = 8
vtk_mode   = slim
out_dir    = output_collision_paper
# gpu      = 0

# ── 后处理（pipeline.sh / render/render.py 读取）──────────────────────────
render_mode  = iso3d       # iso3d | slice | volume | none（可逗号组合，如 iso3d,slice）
render_level = 0.15        # 等值面 = 此值 × 全程 99.5 分位 |ω|
render_orbit = 120         # 转台旋转角度（iso3d）；0 = 固定视角

# ── 作者交叉校验诊断（可选）──
# ic_dir   = ic_shared    # 读取作者的原始交错速度场 ic{x,y,z}.raw 作为初始条件
# dump_vel = 1            # 每帧额外 dump 单元中心速度 vx/vy/vz_*.raw（用于 |ω| 轨迹对比）
