# ── Paper-faithful head-on collision (LFM paper Fig. 3) ────────────────────
# Authors' recipe: grid 128x256x256 (collision axis = short 128 dir), INVISCID
# with the BFECC neighbour clamp as numerical viscosity, n=5 steps/cycle, CG
# fixed at 8 iterations. Domain 0.5x1x1 keeps dx=dy=dz uniform (= 1/256).
# Run: ./build/cfdsim inputs/collision_paper.in
#
# Convergence study: bump all three N together (rings auto-scale), e.g.
#   ./build/cfdsim inputs/collision_paper.in NX=64  NY=128 NZ=128 out_dir=output_conv64
#   ./build/cfdsim inputs/collision_paper.in NX=160 NY=320 NZ=320 out_dir=output_conv160

scenario   = collision_paper

backend    = auto       # auto: 有GPU就用GPU，没有自动保底CPU。也可写死 gpu / cpu

NX         = 128
NY         = 256
NZ         = 256
cycles     = 250
dt         = 4e-4

lfm_bfecc_clamp = 1       # paper's BfeccClamp (1 = on). Set 0 to see it blow up.
solve_iters     = 8       # paper: CG fixed at 8 iterations

frame_skip = 4
vtk_mode   = slim
out_dir    = output_collision_paper
# gpu      = 0

# ── 后处理（pipeline.sh / render/render.py 读取）──────────────────────────
render_mode  = iso3d       # iso3d | slice | volume | none（可逗号组合，如 iso3d,slice）
render_level = 0.15        # 等值面 = 此值 × 全程 99.5 分位 |ω|
render_orbit = 120         # 转台旋转角度（iso3d）；0 = 固定视角

# ── 作者交叉校验诊断（可选）──
# ic_dir   = ic_shared    # 读取作者的原始交错速度场 ic{x,y,z}.raw 作为初始条件
# dump_vel = 1            # 每帧额外 dump 单元中心速度 vx/vy/vz_*.raw（用于 |ω| 轨迹对比）
