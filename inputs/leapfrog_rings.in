# ── Leapfrogging vortex rings (LFM paper Fig. 14) ──────────────────────────
# Two coaxial same-sign rings that leapfrog along +x. Domain 2x1x1 (long axis =
# propagation axis), dx=dy=dz=1/128. Inviscid + BFECC clamp.
# Run: ./build/cfdsim inputs/leapfrog_rings.in

scenario   = leapfrog_rings

backend    = auto       # auto: 有GPU就用GPU，没有自动保底CPU。也可写死 gpu / cpu

NX         = 256          # long axis = propagation axis (domain 2x1x1)
NY         = 128
NZ         = 128
cycles     = 300
dt         = 1e-3
Lx         = 2.0
Ly         = 1.0
Lz         = 1.0
U_inf      = 1.0
Re         = 0            # inviscid — stability from the BFECC clamp
cyl_R      = 0.1          # ring size scale
lfm_bfecc_clamp = 1
solve_iters     = 15      # paper: CG fixed at 15 iterations
solve_tol       = 0.0     # fixed-iteration CG (no tolerance early-out)
lfm_cycle_steps = 10      # paper: n = 10 steps per reinitialization cycle

circulation = 1.0

frame_skip = 4
vtk_mode   = slim
out_dir    = output_leapfrog_rings

# ── 后处理（pipeline.sh / render/render.py 读取）──────────────────────────
render_mode  = iso3d       # iso3d | slice | volume | none（可逗号组合，如 iso3d,slice）
render_level = 0.15        # 等值面 = 此值 × 全程 99.5 分位 |ω|
render_orbit = 120         # 转台旋转角度（iso3d）；0 = 固定视角
