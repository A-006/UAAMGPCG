# ── Single vortex ring (GPU-resident 3D LFM) ───────────────────────────────
# Run: ./build/cfdsim inputs/vortex_ring.in
# Override any line on the command line, e.g.:  ./build/cfdsim inputs/vortex_ring.in NX=96
#
# Format: key = value, one per line. '#' starts a comment.
# Lines you omit fall back to the scenario's built-in defaults.

scenario   = vortex_ring

backend    = auto       # auto: 有GPU就用GPU，没有自动保底CPU。也可写死 gpu / cpu
# gpu      = 0            # which CUDA device (backend=gpu only); uncomment on multi-GPU

NX         = 64           # cube grid NX^3 (NY, NZ default to NX here)
NY         = 64
NZ         = 64
cycles     = 60           # number of LFM reinitialization cycles
dt         = 0.002
Re         = 0            # 0 = inviscid

circulation = 1.0         # ring strength

frame_skip = 1            # write a VTK frame every N cycles
vtk_mode   = full         # "full" (velocity+scalars) or "slim" (|omega| only)
out_dir    = output_vortex_ring
# gpu      = 0            # CUDA device index (uncomment on multi-GPU machines)

# ── 后处理（pipeline.sh / render/render.py 读取）──────────────────────────
render_mode  = iso3d       # iso3d | slice | volume | none（可逗号组合，如 iso3d,slice）
render_level = 0.15        # 等值面 = 此值 × 全程 99.5 分位 |ω|
render_orbit = 120         # 转台旋转角度（iso3d）；0 = 固定视角
